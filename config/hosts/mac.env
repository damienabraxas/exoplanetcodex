# Host profile: Ryan's Mac (a MIRROR of Sirius; Sirius is the source of truth).
# Sirius needs no profile -- every path-register default is the Sirius location.
#   source config/hosts/mac.env && python run_pipeline.py --check-paths
# Paths only, $HOME-relative: no username and no secrets in this file.
export SIRIUS_DATA_ROOT="$HOME/codex"
export CODEX_SRV_SOLAR_ROOT="$HOME/codex/sirius_local_srv/solar_reference"
export CODEX_GRID_ROOT="$HOME/Documents/Exoplanet Codex/grids"
export CODEX_KP_ATLAS="$HOME/codex/spectra/Kitt Peak Flux Atlas"
export ISPEC_DIR="$HOME/codex/ispec"
export CODEX_SYNTH_PYTHON="$HOME/codex/venv/bin/python"
export PYTHONUNBUFFERED=1
export CODEX_VALD_RAW="$HOME/Documents/Exoplanet Codex/vald_raw_archive/current"
export CODEX_ENGINE_ROOT="$HOME/codex/engines"
