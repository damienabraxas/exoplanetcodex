# FITS and spectral data files
*.fits
*.fit
*.fts
*.fits.gz

# Pipeline outputs
results/plots/
results/tables/
data/raw/
data/processed/
# RYA-469: per-star NAMESPACED working outputs (regenerable). The FROZEN gold solar
# reference under data/reference/ is committed (NOT ignored) — it is the differential
# denominator and is immutability-guarded.
data/outputs/

# Per-night GDAS profile cache (RYA-380) — regenerated by pipeline.telluric.gdas_fetch
# from the ESO telluriccorr tarball / NOAA ARL manual pulls; never committed.
data/telluric/gdas_cache/

# Stewardship check artifacts (regenerated by scripts/check_stewardship.py — RYA-355)
data/results/gf_divergence_*.csv

# Model atmosphere grids (large binary files)
data/model_atmospheres/*.mod
data/model_atmospheres/*.dat

