@@ -108,6 +110,73 @@ MODULE hop_c_api
 
 CONTAINS
 
+  ! SPDX-License-Identifier: GPL-3.0-only
+  ! Experimental derivative of SRC/nlte_patch_mod.f90::exclude_double_continua
+  ! at32085d26c. Atomic non-hydrogen subset only; no rate/opacity coefficients
+  ! changed. Call after init and before any EOS state is loaded.
+  FUNCTION hop_exclude_model_continua(id, awgt, ncont, stages, exc, nexcluded) &
+      RESULT(status) BIND(c, name='hop_exclude_model_continua')
+    USE, INTRINSIC :: ieee_arithmetic, only: ieee_is_finite
+    character(kind=c_char), intent(in) :: id(*)
+    real(c_double), value :: awgt
+    integer(c_int), value :: ncont
+    integer(c_int), intent(in) :: stages(*)
+    real(c_double), intent(in) :: exc(*)
+    integer(c_int), intent(out) :: nexcluded
+    integer(c_int) :: status
+    character(len=:), allocatable :: name
+    class(element_type), pointer :: element
+    integer :: i, k, split
+    logical :: same_species, match
+    status=0
+    nexcluded=0
+    if (.not. allocated(master) .or. allocated(comp)) then
+      call fail('trace selection requires initialized, never-loaded master', 3, status)
+      return
+    endif
+    call c2f_string(id, name)
+    if (.not. ieee_is_finite(awgt) .or. awgt<=0 .or. ncont<1 .or. ncont>10000) then
+      call fail('invalid explicit trace identity/count', 3, status)
+      return
+    endif
+    call master%element_by_id(name, element)
+    if (.not. associated(element) .or. lowercase(trim(name))=='h') then
+      call fail('only atomic non-hydrogen trace selection is qualified', 3, status)
+      return
+    endif
+    if (any(stages(1:ncont)<1) .or. any(stages(1:ncont)>element%nion) .or. &
+        any(.not. ieee_is_finite(exc(1:ncont))) .or. any(exc(1:ncont)<0)) then
+      call fail('invalid trace continuum stage/excitation', 3, status)
+      return
+    endif
+    do i=1, size(master%trans)
+      associate(trans=>master%trans(i))
+      if (.not. trans%active .or. .not. associated(trans%ion)) cycle
+      if (trans%molecular .or. trans%level%g<=0) cycle
+      split=index(trans%ion%id,' ')
+      if (split==0) split=len_trim(trans%ion%id)+1
+      same_species=lowercase(trans%ion%id(:split-1))==lowercase(trim(name)) .and. &
+          abs(trans%ion%awgt/awgt-1)<1d-2
+      if (.not. same_species) cycle
+      match=.false.
+      do k=1,ncont
+        if (stages(k)/=trans%ion%j) cycle
+        if (exc(k)==0) then
+          match=trans%level%xion==0
+        else
+          match=abs(trans%level%xion/exc(k)-1)<1d-2
+        endif
+        if (match) exit
+      enddo
+      if (match) then
+        trans%active=.false.
+        nexcluded=nexcluded+1
+        write(*,'(a,1x,a)') 'BRIDE_TRACE_EXCLUDE',trim(trans%label)
+      endif
+      end associate
+    enddo
+  END FUNCTION hop_exclude_model_continua
+
