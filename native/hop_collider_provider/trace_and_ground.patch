+  ! SPDX-License-Identifier: GPL-3.0-only
+  ! Read the exact native atom_mod collision nh1 field, never the ion total.
+  FUNCTION hop_get_h_ground(n, out, occupation) RESULT(status) BIND(c, name='hop_get_h_ground')
+    integer(c_int), value :: n
+    real(c_double), intent(out) :: out(*), occupation(*)
+    integer(c_int) :: status
+    status = 0
+    if (hop_get_n() /= n .or. n < 1) then
+      call fail('hop_get_h_ground: require loaded state and exact size', 3, status)
+      return
+    endif
+    if (comp%elements(1)%id /= 'H') then
+      call fail('hop_get_h_ground: first element must be hydrogen', 4, status)
+      return
+    endif
+    if (.not. allocated(comp%elements(1)%ions(1)%levels)) then
+      call fail('hop_get_h_ground: hydrogen levels absent', 4, status)
+      return
+    endif
+    if (size(comp%elements(1)%ions(1)%levels) < 1) then
+      call fail('hop_get_h_ground: hydrogen ground absent', 4, status)
+      return
+    endif
+    if (.not. allocated(comp%elements(1)%ions(1)%levels(1)%n)) then
+      call fail('hop_get_h_ground: hydrogen ground density not retained', 4, status)
+      return
+    endif
+    if (.not. allocated(comp%elements(1)%ions(1)%levels(1)%w)) then
+      call fail('hop_get_h_ground: require explicit occupation-weighted H recipe', 4, status)
+      return
+    endif
+    out(1:n) = reshape(comp%elements(1)%ions(1)%levels(1)%n, [n])
+    occupation(1:n) = reshape(comp%elements(1)%ions(1)%levels(1)%w, [n])
+  END FUNCTION hop_get_h_ground
