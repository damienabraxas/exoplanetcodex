   !> Adds the slab's rates to the atom's rates on the composition patch, under its
   !> lock.
   !===============================================================================
+  !> Isolated serial diagnostic: replay rate integrals only, restore ALL solver sums.
+  !> No population, opacity, radiation or global preconditioning change.
+  SUBROUTINE audit_gross_rates(self, atom, trans, adata, kind, comp, wmu, vproj, iatom)
+    class(rt_patch_t) :: self
+    class(atom_type) :: atom
+    class(atom_trans_t) :: trans
+    class(atom_data_t) :: adata
+    integer, intent(in) :: kind
+    class(composition_type), optional :: comp
+    real(4), optional :: wmu
+    real(4), optional, contiguous :: vproj(:,:,:)
+    integer, optional :: iatom
+    real(4), allocatable :: saved_up(:,:,:,:), saved_down(:,:,:,:)
+    integer, allocatable :: indices(:)
+    integer :: unit, k, nr
+    character(len=256) :: filename
+    allocate(saved_up, source=trans%gamma_ij)
+    allocate(saved_down, source=trans%gamma_ji)
+    trans%gamma_ij = 0.
+    trans%gamma_ji = 0.
+    if (kind == 1) then
+      call self%bound_bound_rates(comp, atom, trans, adata, wmu, vproj, iatom, audit_physical=.true.)
+    else
+      call self%bound_free_rates(atom, trans, adata, audit_physical=.true.)
+    endif
+    nr = size(trans%gamma_ij,4)
+    allocate(indices(nr))
+    do k=1,size(trans%line)
+      indices(k) = trans%line(k)%ntrans
+    enddo
+    do k=1,size(trans%cont)
+      indices(k+size(trans%line)) = trans%cont(k)%ntrans
+    enddo
+    write(filename,'(a,"audit_gross_",i5.5,"_",i5.5,".bin")') trim(io%run_dir)//'save/', self%iter, self%zs
+    open(newunit=unit,file=trim(filename),access='stream',form='unformatted',status='unknown',position='append')
+    write(unit) int([1371,1,kind,self%iter,self%zs,self%nx,self%ny,self%nz,nr,atom%nlevel,self%fs,self%dir],4)
+    write(unit) int(indices,4), trans%gamma_ij, trans%gamma_ji
+    write(unit) adata%b * adata%nstar, adata%nstar
+    close(unit)
+    trans%gamma_ij = saved_up
+    trans%gamma_ji = saved_down
+  END SUBROUTINE audit_gross_rates
+
