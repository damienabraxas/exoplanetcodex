+!> Isolated control: same fp32 inputs, offset arithmetic and normalization as
+!> qlg_bot_profile; only the profile kernel is the existing fp64 reference.
+  ELEMENTAL FUNCTION qlg_ref_profile (a, q, vpr, idf) result (h)
+    real(4), intent(in) :: a, q, vpr, idf
+    real(4) :: h, v
+    real(8) :: K1(1)
+    v = abs(q - vpr) * idf
+    call qlg_ref_f64(real(a,8), real(v,8), 0.0d0, 1, K1)
+    h = real(K1(1),4) * ISQPI * idf * (q + 1.0)
+  END FUNCTION qlg_ref_profile
+
 END MODULE qlg
