# %ECSV 1.0
# ---
# datatype:
# - name: Wave
#   unit: 0.1 nm
#   datatype: float64
#   format: '{:12.6f}'
#   description: Wavelength of the transition (wavelength)
#   meta: !!omap
#   - {ucd: SPECT_WAVELENGTH_MISC}
#   - {width: 12}
#   - {precision: '6'}
# - name: El
#   datatype: string
#   description: Chemical element (element)
#   meta: !!omap
#   - {ucd: AT_ELEMENT}
#   - {_votable_string_dtype: char}
# - name: LEP
#   unit: eV
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Lower excitation potential (EP)'
#   meta: !!omap
#   - {ucd: AT_ENERGY_EXCIT}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: loggf
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Oscillator strength (loggf)'
#   meta: !!omap
#   - {ucd: AT_OSC_STRENGTH}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: C6
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Van der Waals broadening constant (C6)'
#   meta: !!omap
#   - {ucd: AT_CONSTANT}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDDepS
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Line depth measured in the synthetic spectrum for F dwarf (F_Dwarf_depth_syn)'
#   meta: !!omap
#   - {ucd: SPECT_LINE_DEPTH_VALUE}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDWoffS
#   unit: 0.1 nm
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Wavelength offset of the synthetic line center relative to the nominal line wavelength for F dwarf (F_Dwarf_del_wav_syn)'
#   meta: !!omap
#   - {ucd: SPECT_WAVELENGTH_DIFF}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: f_FDDepS
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Warning flag associated with the synthetic-spectrum line measurement for F dwarf (F_Dwarf_warn_synth)'
#   meta: !!omap
#   - {ucd: SPECT_LINE_DEPTH_VALUE}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDDepO
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Line depth measured in the observed spectrum for F dwarf (F_Dwarf_depth_obs)'
#   meta: !!omap
#   - {ucd: SPECT_LINE_DEPTH_VALUE}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDWoffO
#   unit: 0.1 nm
#   datatype: float64
#   format: '{:11.6f}'
#   description: '? Wavelength offset of the observed line center relative to the nominal line wavelength for F dwarf (F_Dwarf_del_wav_obs)'
#   meta: !!omap
#   - {ucd: SPECT_WAVELENGTH_DIFF}
#   - {width: 11}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: f_FDDepO
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Warning flag associated with the observed-spectrum line measurement for F dwarf (F_Dwarf_warn_obs)'
#   meta: !!omap
#   - {ucd: SPECT_LINE_DEPTH_VALUE}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDDepth
#   datatype: string
#   description: Depth-selection flag (Y/N) for F dwarf (F_Dwarf_Flag_depth)
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# - name: FDSat
#   datatype: string
#   description: Unsaturated-line flag (Y/N) for F dwarf (F_Dwarf_Flag_Unsaturated)
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# - name: FDPurEW
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Purity estimator based on equivalent width for F dwarf (F_Dwarf_Purity_EW)'
#   meta: !!omap
#   - {ucd: SPECT_EQ-WIDTH}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDPur
#   datatype: string
#   description: Purity-selection flag (Y/N) for F dwarf (F_Dwarf_Flag_Purity)
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# - name: FDRMSE
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Root-mean-square error of the observed vs synthetic comparison for F dwarf (F_Dwarf_RMSE)'
#   meta: !!omap
#   - {ucd: FIT_ERROR}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDMAD
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Median absolute deviation of the residuals for F dwarf (F_Dwarf_MAD)'
#   meta: !!omap
#   - {ucd: FIT_STDEV}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDChi2
#   datatype: float64
#   format: '{:10.6f}'
#   description: '? Reduced chi-square of the observed vs synthetic comparison for F dwarf (F_Dwarf_Chi2_Red)'
#   meta: !!omap
#   - {ucd: FIT_CHI2}
#   - {width: 10}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: FDGoF
#   datatype: string
#   description: Goodness-of-fit flag (Y/N) for F dwarf (F_Dwarf_Flag_GoF)
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# - name: FDRob
#   datatype: string
#   description: Final robust-line flag (Y/N), obtained by combining the selection criteria for F dwarf (F_Dwarf_Robust)
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# meta: !!omap
# - {ID: J_A_A_710_A111_atomicj}
# - {name: J/A+A/710/A111/atomicj}
# - {description: '*Atomic data and line-selection diagnostics for the J-band transitions'}
# schema: astropy-2.0
Wave El LEP loggf C6 FDDepS FDWoffS f_FDDepS FDDepO FDWoffO f_FDDepO FDDepth FDSat FDPurEW FDPur FDRMSE FDMAD FDChi2 FDGoF FDRob
