{
  "schema_version": "1.0.0",
  "product_id": "codex-local-stellar-neighborhood-v1",
  "coordinate_system": {
    "input_frame": "ICRS",
    "input_epoch": "J2000",
    "output_frame": "heliocentric Galactic Cartesian",
    "axes": {
      "x_gc": "toward Galactic center (l=0\u00b0, b=0\u00b0)",
      "y_rotation": "direction of Galactic rotation (l=90\u00b0, b=0\u00b0)",
      "z_ngp": "toward north Galactic pole (b=+90\u00b0)"
    },
    "projection": "orthographic x_gc-y_rotation; no visual coordinate nudging",
    "extent_pc": 65
  },
  "provenance": {
    "membership": "all rows in data/catalog/system_catalog.csv; target ID is star_params_key when present, otherwise website_slug",
    "stellar_parameters": "optional join through config/stars.yaml / STAR_PARAMS; never a membership filter",
    "astrometry": {
      "schema_version": "1.0.0",
      "ticket": "RYA-1065",
      "source": "SIMBAD (CDS) preferred ICRS J2000 positions and parallaxes",
      "retrieved": "2026-08-26",
      "position_unit": "degree",
      "parallax_unit": "milliarcsecond",
      "distance_derivation": "distance_pc = 1000 / parallax_mas; valid because every committed parallax is positive",
      "membership_join": "target_id is star_params_key when present, otherwise website_slug, from data/catalog/system_catalog.csv",
      "source_url_template": "https://simbad.cds.unistra.fr/simbad/sim-id?Ident={system_name}",
      "notes": [
        "Alpha Centauri A and B share the system parallax selected by SIMBAD; their distinct component positions remain truthful and nearly coincident at neighborhood scale.",
        "The first six fixed-star positions reuse the already committed RYA-952 SIMBAD astrometry values; RYA-1065 extends the same source convention to every registered system.",
        "Gliese 581 uses Gaia DR3 parallax 158.7183 +/- 0.0300 mas, bibliography 2020yCat.1350....0G."
      ]
    },
    "transformation": "Astropy SkyCoord ICRS to Galactic Cartesian",
    "generator": "python3 scripts/generate_local_stellar_neighborhood.py --site-root /path/to/exoplanetcodex-site"
  },
